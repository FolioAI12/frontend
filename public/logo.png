<svg width="512" height="512" viewBox="0 0 512 512" fill="none" xmlns="http://www.w3.org/2000/svg">
  <rect width="512" height="512" rx="120" fill="url(#grad)"/>
  <defs>
    <linearGradient id="grad" x1="0" y1="0" x2="512" y2="512" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#00C9A7"/>
      <stop offset="100%" stop-color="#6C63FF"/>
    </linearGradient>
  </defs>
  <!-- F letter mark -->
  <rect x="140" y="140" width="52" height="232" rx="10" fill="white"/>
  <rect x="140" y="140" width="200" height="52" rx="10" fill="white"/>
  <rect x="140" y="232" width="160" height="48" rx="10" fill="white" opacity="0.85"/>
  <!-- AI dot accent -->
  <circle cx="372" cy="340" r="36" fill="white" opacity="0.95"/>
  <circle cx="372" cy="340" r="18" fill="url(#grad)"/>
</svg>