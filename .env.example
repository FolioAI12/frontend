# ─────────────────────────────────────────────────────
# FolioAI — Environment Variables
# Copy this file to .env.local and fill in your values
# ─────────────────────────────────────────────────────

# REQUIRED: Google Gemini API
# Get free key → https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# REQUIRED: Firebase (Google Auth)
# Create project → https://console.firebase.google.com
# Enable Authentication → Google provider
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# REQUIRED: Supabase (Portfolio history storage)
# Create project → https://supabase.com
# Run this SQL in Supabase SQL editor:
#
# create table portfolios (
#   id uuid default gen_random_uuid() primary key,
#   user_id text not null,
#   user_email text,
#   name text not null,
#   template text not null,
#   html text not null,
#   portfolio_data jsonb,
#   created_at timestamptz default now()
# );
# create index on portfolios(user_id);
# alter table portfolios enable row level security;
# create policy "Users see own portfolios" on portfolios
#   for all using (auth.uid()::text = user_id);
#
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
